      "contractArtifacts": [
        "SwapVMSETHVault"
      ],
      "officialRoutes": [
        "/bridge"
      ],
      "sourceDisposition": "evidence-only",
      "deployedByOfficialLaunch": false,
      "officialInterfaceEnabled": false
    },
    {
      "id": "auction",
      "contractArtifacts": [
        "SwapVMSRC20AuctionHouse",
        "SwaputerSRC20AuctionFactory"
      ],
      "officialRoutes": [],
      "sourceDisposition": "evidence-only",
      "deployedByOfficialLaunch": false,
      "officialInterfaceEnabled": false
    }
  ],
  "testnetCompatibility": {
    "environments": [
      "local",
      "testnet"
    ],
    "preserveMarket": true,
    "preserveSETH": true,
    "preserveAuctionEvidence": true
  }
}
