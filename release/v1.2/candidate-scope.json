{
  "schemaVersion": "swaputer-release-scope/1",
  "release": {
    "name": "swaputer-v1.2-stage7m-rc3",
    "protocolVersion": "1.2",
    "status": "unaudited experimental",
    "candidateKind": "local-candidate-freeze",
    "mainnetAuthorized": false,
    "signatureStatus": "not-required-for-local-candidate-freeze"
  },
  "launch": {
    "profile": "core+explorer+studio+open-mint",
    "contracts": [
      "SwapVMCreationCodeStore",
      "SwapVMGasToken",
      "SwapVMHook",
      "SwapVMKernel",
      "SwapVMReferenceRegistry",
      "SwapVMRouter",
      "SwapVMWorldDeployer",
      "SwapVMWorldFactory"
    ],
    "integratedComponents": [
      "SwapVMMiniVM"
    ],
    "officialInterfaces": [
      "explorer",
      "studio",
      "open-mint-minter"
    ],
    "routing": [
      "canonical-swaputer-router",
      "official-uniswap-universal-router-v4-swap"
    ],
    "observability": [
      "receipt-codec",
      "production-indexer",
      "active-release-verifier",
      "ten-minute-testnet-monitoring"
    ]
  },
  "excludedMainnetApplications": [
    {
      "id": "src20-market",
      "contractArtifacts": [
        "SwapVMSRC20Market",
